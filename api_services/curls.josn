{
  "requests": [
    {
      "id": "plans",
      "method": "GET",
      "url": "https://dev.walima.app/api/v1/plans",
      "headers": {
        "accept": "application/json",
        "Authorization": "Bearer {{WALIMA_API_TOKEN}}"
      }
    },
    {
      "id": "subscription",
      "method": "GET",
      "url": "https://dev.walima.app/api/v1/payments/subscription",
      "headers": {
        "accept": "*/*",
        "Authorization": "Bearer {{WALIMA_API_TOKEN}}"
      }
    }
  ]
}